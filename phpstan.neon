parameters:
	level: 6
	paths:
		- setup.php
		- lib/admin.php
		- lib/aip.php
		- lib/api_http.php
		- lib/bootstrap.php
		- lib/mcp_server.php
		- lib/origin.php
		- lib/providers.php
		- lib/registry.php
		- lib/storage.php
	scanFiles:
		- tests/phpstan-stubs.php
	dynamicConstantNames:
		- CACTI_PATH_PLUGINS
		- CACTI_PATH_LOG
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		-
			identifier: missingType.iterableValue
			paths:
				- lib/admin.php
				- lib/aip.php
				- lib/api_http.php
				- lib/bootstrap.php
				- lib/mcp_server.php
				- lib/origin.php
				- lib/registry.php
				- lib/storage.php
		-
			identifier: missingType.parameter
			path: setup.php
		-
			identifier: missingType.return
			path: setup.php
