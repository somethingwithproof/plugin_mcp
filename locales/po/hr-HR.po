msgid "Select at least one item."
msgstr "Odaberite najmanje jednu stavku."

#: mcp_admin.php
msgid "Set by the plugin"
msgstr "Određuje priključak"

#: mcp_admin.php
msgid ""
"Set the Public Cacti URL in Settings > MCP before connecting AI clients."
msgstr ""
"Postavite Javni URL sustava Cacti u Postavke > MCP prije povezivanja AI "
"klijenata."

#: mcp_admin.php mcp_tokens.php
msgid "Started"
msgstr "Započeto"

#: mcp_admin.php mcp_tokens.php
msgid "State"
msgstr "Status"

#: mcp_tokens.php
msgid "That token is not one of your active tokens."
msgstr "Taj token ne pripada vašim aktivnim tokenima."

#: setup.php
msgid ""
"The address MCP clients use to reach this Cacti server, for example https://"
"cacti.example.com/cacti. Required before the MCP endpoint answers."
msgstr ""
"Adresa kojom MCP klijenti pristupaju ovom Cacti poslužitelju, na primjer "
"https://cacti.example.com/cacti. Obvezno prije nego što krajnja točka MCP-a "
"počne odgovarati."

#: mcp_admin.php
msgid "The audit log could not be read."
msgstr "Revizijski dnevnik nije bilo moguće pročitati."

#: mcp_tokens.php
msgid "The available tools could not be listed."
msgstr "Popis raspoloživih alata nije bilo moguće dohvatiti."

#: mcp_admin.php
msgid "The exposure change could not be saved. Nothing was changed."
msgstr "Promjenu izloženosti nije bilo moguće spremiti. Ništa nije promijenjeno."

#: mcp_admin.php
msgid "The exposure settings were saved."
msgstr "Postavke izloženosti su spremljene."

#: mcp_admin.php
msgid "The selection contains an invalid ability. Nothing was changed."
msgstr "Odabir sadrži neispravnu sposobnost. Ništa nije promijenjeno."

#: mcp_admin.php mcp_tokens.php
msgid "The token could not be created."
msgstr "Token nije bilo moguće izraditi."

#: mcp_tokens.php
msgid "The token could not be revoked."
msgstr "Token nije bilo moguće opozvati."

#: mcp_admin.php mcp_tokens.php
msgid "The token list could not be read."
msgstr "Popis tokena nije bilo moguće pročitati."

#: mcp_tokens.php
msgid "The token was revoked."
msgstr "Token je opozvan."

#: mcp_admin.php
msgid "The tokens could not be revoked."
msgstr "Tokene nije bilo moguće opozvati."

#: mcp_admin.php mcp_tokens.php
msgid "The tokens were revoked, but the audit entry could not be written."
msgstr ""
"Tokeni su opozvani, ali revizijski unos nije bilo moguće zapisati."

#: mcp_tokens.php
msgid ""
"These are the read-only abilities a token of yours can use today. Your Cacti "
"permissions and the administrator's exposure settings decide the list."
msgstr ""
"Ovo su sposobnosti samo za čitanje koje vaš token trenutačno može koristiti. "
"Vaše ovlasti u sustavu Cacti i administratorske postavke izloženosti određuju "
"ovaj popis."

#: mcp_admin.php mcp_tokens.php
msgid "This form was already submitted."
msgstr "Ovaj je obrazac već poslan."

#: mcp_admin.php mcp_tokens.php
msgid "Token"
msgstr "Token"

#: mcp_admin.php mcp_tokens.php
msgid "Tokens"
msgstr "Tokeni"

#: lib/admin.php
msgid "Tokens cannot be created for the guest account or disabled users."
msgstr ""
"Tokeni se ne mogu izraditi za gostujući račun niti za onemogućene korisnike."

#: mcp_admin.php
msgid "User"
msgstr "Korisnik"

#: mcp_admin.php
msgid "Yes"
msgstr "Da"

#: mcp_tokens.php
msgid "You have no tokens"
msgstr "Nemate tokena"

#: mcp_admin.php
msgid ""
"You may only create tokens for yourself without the Users/Groups permission."
msgstr ""
"Bez ovlasti Korisnici/Grupe možete izrađivati tokene samo za sebe."

#: mcp_tokens.php
msgid "Your activity could not be read."
msgstr "Vašu aktivnost nije bilo moguće pročitati."
