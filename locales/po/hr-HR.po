msgstr "Nema pronađenih aktivnosti"

#: mcp_admin.php
msgid "No audit entries found"
msgstr "Nema pronađenih revizijskih unosa"

#: mcp_admin.php
msgid "No tokens found"
msgstr "Nema pronađenih tokena"

