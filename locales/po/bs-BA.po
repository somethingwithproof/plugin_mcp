#: mcp_admin.php
msgid ""
"Set the Public Cacti URL in Settings > MCP before connecting AI clients."
msgstr ""
"Postavite Javni Cacti URL u Postavke > MCP prije povezivanja AI klijenata."

#: mcp_admin.php mcp_tokens.php
msgid "Started"
msgstr "Pokrenuto"

#: mcp_admin.php mcp_tokens.php
msgid "State"
msgstr "Stanje"

#: mcp_tokens.php
msgid "That token is not one of your active tokens."
msgstr "Taj token nije jedan od vaših aktivnih tokena."

#: setup.php
msgid ""
"The address MCP clients use to reach this Cacti server, for example https://"
"cacti.example.com/cacti. Required before the MCP endpoint answers."
msgstr ""
"Adresa koju MCP klijenti koriste za pristup ovom Cacti serveru, na primjer "
"https://cacti.example.com/cacti. Obavezno prije nego što MCP krajnja tačka "
"počne odgovarati."

#: mcp_admin.php
msgid "The audit log could not be read."
msgstr "Zapisnik revizije nije mogao biti pročitan."

#: mcp_tokens.php
msgid "The available tools could not be listed."
msgstr "Spisak dostupnih alata nije mogao biti prikazan."

#: mcp_admin.php
msgid "The exposure change could not be saved. Nothing was changed."
msgstr "Promjena izloženosti nije mogla biti sačuvana. Ništa nije izmijenjeno."

#: mcp_admin.php
msgid "The exposure settings were saved."
msgstr "Postavke izloženosti su sačuvane."

#: mcp_admin.php
msgid "The selection contains an invalid ability. Nothing was changed."
msgstr "Izbor sadrži nevažeću mogućnost. Ništa nije izmijenjeno."

#: mcp_admin.php mcp_tokens.php
msgid "The token could not be created."
msgstr "Token nije mogao biti kreiran."

#: mcp_tokens.php
msgid "The token could not be revoked."
msgstr "Token nije mogao biti opozvan."

#: mcp_admin.php mcp_tokens.php
msgid "The token list could not be read."
msgstr "Spisak tokena nije mogao biti pročitan."

#: mcp_tokens.php
msgid "The token was revoked."
msgstr "Token je opozvan."

#: mcp_admin.php
msgid "The tokens could not be revoked."
msgstr "Tokeni nisu mogli biti opozvani."

#: mcp_admin.php mcp_tokens.php
msgid "The tokens were revoked, but the audit entry could not be written."
msgstr "Tokeni su opozvani, ali zapis revizije nije mogao biti upisan."

#: mcp_tokens.php
msgid ""
"These are the read-only abilities a token of yours can use today. Your Cacti "
"permissions and the administrator's exposure settings decide the list."
msgstr ""
"Ovo su mogućnosti samo za čitanje koje vaš token danas može koristiti. Vaše "
"Cacti dozvole i administratorske postavke izloženosti određuju ovaj spisak."

#: mcp_admin.php mcp_tokens.php
msgid "This form was already submitted."
msgstr "Ovaj obrazac je već poslan."

#: mcp_admin.php mcp_tokens.php
msgid "Token"
msgstr "Token"

#: mcp_admin.php mcp_tokens.php
msgid "Tokens"
msgstr "Tokeni"

#: lib/admin.php
msgid "Tokens cannot be created for the guest account or disabled users."
msgstr ""
"Tokeni se ne mogu kreirati za gostujući nalog niti za onemogućene korisnike."

#: mcp_admin.php
msgid "User"
msgstr "Korisnik"

#: mcp_admin.php
msgid "Yes"
msgstr "Da"

#: mcp_tokens.php
msgid "You have no tokens"
msgstr "Nemate nijedan token"

#: mcp_admin.php
msgid ""
"You may only create tokens for yourself without the Users/Groups permission."
msgstr ""
"Bez dozvole Korisnici/Grupe možete kreirati tokene samo za sebe."

#: mcp_tokens.php
msgid "Your activity could not be read."
msgstr "Vaša aktivnost nije mogla biti pročitana."
