#: lib/admin.php
msgid "Tokens cannot be created for the guest account or disabled users."
msgstr "Δεν είναι δυνατή η δημιουργία διακριτικών για τον λογαριασμό επισκέπτη ή για απενεργοποιημένους χρήστες."

#: mcp_admin.php
msgid "User"
msgstr "Χρήστης"

#: mcp_admin.php
msgid "Yes"
msgstr "Ναι"

#: mcp_tokens.php
msgid "You have no tokens"
msgstr "Δεν έχετε διακριτικά"

#: mcp_admin.php
msgid "You may only create tokens for yourself without the Users/Groups permission."
msgstr "Χωρίς το δικαίωμα «Χρήστες/Ομάδες» μπορείτε να δημιουργείτε διακριτικά μόνο για τον εαυτό σας."

#: mcp_tokens.php
msgid "Your activity could not be read."
msgstr "Δεν ήταν δυνατή η ανάγνωση της δραστηριότητάς σας."
