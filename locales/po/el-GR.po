msgstr "Επιλέξτε ένα διακριτικό για ανάκληση."

#: mcp_admin.php
msgid "Choose a user and an expiry of 1 to 365 days."
msgstr "Επιλέξτε έναν χρήστη και διάρκεια λήξης από 1 έως 365 ημέρες."

#: mcp_admin.php
msgid "Choose an action."
msgstr "Επιλέξτε μια ενέργεια."

#: mcp_tokens.php
msgid "Choose an expiry of 1 to 365 days."
msgstr "Επιλέξτε διάρκεια λήξης από 1 έως 365 ημέρες."

#: mcp_admin.php
msgid "Clear"
msgstr "Εκκαθάριση"

#: mcp_admin.php
msgid "Click Continue to expose these abilities to AI clients. Users still need the realm each ability requires."
msgstr "Κάντε κλικ στο «Συνέχεια» για να εκθέσετε αυτές τις δυνατότητες σε πελάτες AI. Οι χρήστες εξακολουθούν να χρειάζονται τον τομέα δικαιωμάτων που απαιτεί κάθε δυνατότητα."

#: mcp_admin.php
msgid "Click Continue to hide these abilities from AI clients."
msgstr "Κάντε κλικ στο «Συνέχεια» για να αποκρύψετε αυτές τις δυνατότητες από τους πελάτες AI."

#: mcp_admin.php
msgid "Click Continue to revoke these tokens. Revoked tokens cannot be used again."
msgstr "Κάντε κλικ στο «Συνέχεια» για να ανακαλέσετε αυτά τα διακριτικά. Τα ανακλημένα διακριτικά δεν μπορούν να χρησιμοποιηθούν ξανά."

#: mcp_admin.php
msgid "Continue"
msgstr "Συνέχεια"

#: mcp_admin.php mcp_tokens.php
msgid "Copy this token now. It is not shown again."
msgstr "Αντιγράψτε αυτό το διακριτικό τώρα. Δεν θα εμφανιστεί ξανά."

