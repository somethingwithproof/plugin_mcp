msgstr "Наличните инструменти не можаха да бъдат изведени."

#: mcp_admin.php
msgid "The exposure change could not be saved. Nothing was changed."
msgstr "Промяната в предоставянето не можа да бъде запазена. Нищо не беше променено."

#: mcp_admin.php
msgid "The exposure settings were saved."
msgstr "Настройките за предоставяне бяха запазени."

#: mcp_admin.php
