msgstr "Нису пронађени записи ревизије"

#: mcp_admin.php
msgid "No tokens found"
msgstr "Нису пронађени токени"

#: mcp_admin.php
msgid "None of the selected abilities is registered."
msgstr "Ниједна од изабраних могућности није регистрована."

#: mcp_admin.php
msgid "None of the selected tokens are active."
msgstr "Ниједан од изабраних токена није активан."

