msgid "Revoke"
msgstr "Опозови"

#: mcp_admin.php
msgid "Revoke Tokens"
msgstr "Опозови токене"

#: mcp_admin.php mcp_tokens.php
msgid "Revoked"
msgstr "Опозван"

#: mcp_admin.php
msgid "Select at least one item."
msgstr "Изаберите бар једну ставку."

#: mcp_admin.php
msgid "Set by the plugin"
msgstr "Поставља додатак"

#: mcp_admin.php
msgid ""
"Set the Public Cacti URL in Settings > MCP before connecting AI clients."
msgstr ""
"Поставите Јавни Cacti URL у Подешавања > MCP пре повезивања AI клијената."

#: mcp_admin.php mcp_tokens.php
msgid "Started"
msgstr "Покренуто"

#: mcp_admin.php mcp_tokens.php
msgid "State"
msgstr "Стање"

#: mcp_tokens.php
msgid "That token is not one of your active tokens."
msgstr "Тај токен није један од ваших активних токена."

#: setup.php
msgid ""
"The address MCP clients use to reach this Cacti server, for example https://"
"cacti.example.com/cacti. Required before the MCP endpoint answers."
msgstr ""
"Адреса коју MCP клијенти користе за приступ овом Cacti серверу, на пример "
"https://cacti.example.com/cacti. Обавезно пре него што MCP крајња тачка "
"почне да одговара."

#: mcp_admin.php
msgid "The audit log could not be read."
msgstr "Дневник ревизије није могао бити прочитан."

#: mcp_tokens.php
msgid "The available tools could not be listed."
msgstr "Списак доступних алата није могао бити приказан."

#: mcp_admin.php
msgid "The exposure change could not be saved. Nothing was changed."
msgstr "Промена изложености није могла бити сачувана. Ништа није измењено."

#: mcp_admin.php
msgid "The exposure settings were saved."
msgstr "Подешавања изложености су сачувана."

#: mcp_admin.php
msgid "The selection contains an invalid ability. Nothing was changed."
msgstr "Избор садржи неважећу могућност. Ништа није измењено."

#: mcp_admin.php mcp_tokens.php
msgid "The token could not be created."
msgstr "Токен није могао бити направљен."

#: mcp_tokens.php
msgid "The token could not be revoked."
msgstr "Токен није могао бити опозван."

#: mcp_admin.php mcp_tokens.php
msgid "The token list could not be read."
msgstr "Списак токена није могао бити прочитан."

#: mcp_tokens.php
msgid "The token was revoked."
msgstr "Токен је опозван."

#: mcp_admin.php
msgid "The tokens could not be revoked."
msgstr "Токени нису могли бити опозвани."

#: mcp_admin.php mcp_tokens.php
msgid "The tokens were revoked, but the audit entry could not be written."
msgstr "Токени су опозвани, али запис ревизије није могао бити уписан."

#: mcp_tokens.php
msgid ""
"These are the read-only abilities a token of yours can use today. Your Cacti "
"permissions and the administrator's exposure settings decide the list."
msgstr ""
"Ово су могућности само за читање које ваш токен данас може да користи. Ваше "
"Cacti дозволе и администраторска подешавања изложености одређују овај списак."

#: mcp_admin.php mcp_tokens.php
msgid "This form was already submitted."
msgstr "Овај образац је већ послат."

#: mcp_admin.php mcp_tokens.php
msgid "Token"
msgstr "Токен"

#: mcp_admin.php mcp_tokens.php
msgid "Tokens"
msgstr "Токени"

#: lib/admin.php
msgid "Tokens cannot be created for the guest account or disabled users."
msgstr ""
"Токени се не могу направити за гостујући налог нити за онемогућене кориснике."

#: mcp_admin.php
msgid "User"
msgstr "Корисник"

#: mcp_admin.php
msgid "Yes"
msgstr "Да"

#: mcp_tokens.php
msgid "You have no tokens"
msgstr "Немате ниједан токен"

#: mcp_admin.php
msgid ""
"You may only create tokens for yourself without the Users/Groups permission."
msgstr ""
"Без дозволе Корисници/Групе можете правити токене само за себе."

#: mcp_tokens.php
msgid "Your activity could not be read."
msgstr "Ваша активност није могла бити прочитана."
