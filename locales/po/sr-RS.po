msgstr "MCP и Abilities API"

#: setup.php
msgid "MCP installation is incomplete"
msgstr "Инсталација MCP-а је непотпуна"

#: mcp_tokens.php
msgid "MCP tokens are available on the main poller only."
msgstr "MCP токени су доступни само на главном полеру."

#: mcp_tokens.php
msgid "MCP tokens need a signed-in Cacti user."
msgstr "За MCP токене потребан је пријављени Cacti корисник."

