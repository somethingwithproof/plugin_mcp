msgstr "Виберіть принаймні один елемент."

#: mcp_admin.php
msgid "Set by the plugin"
msgstr "Задано плагіном"

#: mcp_admin.php
msgid "Set the Public Cacti URL in Settings > MCP before connecting AI clients."
msgstr "Задайте публічний URL Cacti у меню Налаштування > MCP перед під'єднанням клієнтів ШІ."

