msgid "The token could not be created."
msgstr "Не вдалося створити токен."

#: mcp_tokens.php
msgid "The token could not be revoked."
msgstr "Не вдалося відкликати токен."

#: mcp_admin.php mcp_tokens.php
msgid "The token list could not be read."
msgstr "Не вдалося прочитати список токенів."

#: mcp_tokens.php
msgid "The token was revoked."
msgstr "Токен відкликано."

#: mcp_admin.php
msgid "The tokens could not be revoked."
msgstr "Не вдалося відкликати токени."

#: mcp_admin.php mcp_tokens.php
msgid "The tokens were revoked, but the audit entry could not be written."
msgstr "Токени відкликано, але не вдалося записати запис аудиту."

#: mcp_tokens.php
msgid "These are the read-only abilities a token of yours can use today. Your Cacti permissions and the administrator's exposure settings decide the list."
msgstr "Це можливості лише для читання, які ваш токен може використовувати зараз. Список визначається вашими дозволами Cacti та налаштуваннями відкриття доступу адміністратора."

#: mcp_admin.php mcp_tokens.php
msgid "This form was already submitted."
msgstr "Цю форму вже надіслано."

