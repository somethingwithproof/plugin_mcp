msgstr "Цей токен не належить до ваших активних токенів."

#: setup.php
msgid "The address MCP clients use to reach this Cacti server, for example https://cacti.example.com/cacti. Required before the MCP endpoint answers."
msgstr "Адреса, яку клієнти MCP використовують для звернення до цього сервера Cacti, наприклад https://cacti.example.com/cacti. Обов'язкова для того, щоб кінцева точка MCP відповідала."

#: mcp_admin.php
msgid "The audit log could not be read."
msgstr "Не вдалося прочитати журнал аудиту."

#: mcp_tokens.php
msgid "The available tools could not be listed."
msgstr "Не вдалося отримати список доступних інструментів."

#: mcp_admin.php
msgid "The exposure change could not be saved. Nothing was changed."
msgstr "Не вдалося зберегти зміну відкриття доступу. Нічого не змінено."

#: mcp_admin.php
msgid "The exposure settings were saved."
msgstr "Налаштування відкриття доступу збережено."

#: mcp_admin.php
msgid "The selection contains an invalid ability. Nothing was changed."
msgstr "Вибір містить неприпустиму можливість. Нічого не змінено."

