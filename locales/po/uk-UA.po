msgstr "Виберіть термін дії від 1 до 365 днів."

#: mcp_admin.php
msgid "Clear"
msgstr "Очистити"

#: mcp_admin.php
msgid "Click Continue to expose these abilities to AI clients. Users still need the realm each ability requires."
msgstr "Натисніть «Продовжити», щоб відкрити ці можливості для клієнтів ШІ. Користувачам усе одно потрібен дозвіл (realm), якого вимагає кожна можливість."

#: mcp_admin.php
msgid "Click Continue to hide these abilities from AI clients."
msgstr "Натисніть «Продовжити», щоб приховати ці можливості від клієнтів ШІ."

#: mcp_admin.php
msgid "Click Continue to revoke these tokens. Revoked tokens cannot be used again."
msgstr "Натисніть «Продовжити», щоб відкликати ці токени. Відкликані токени не можна використовувати повторно."

#: mcp_admin.php
msgid "Continue"
msgstr "Продовжити"

#: mcp_admin.php mcp_tokens.php
msgid "Copy this token now. It is not shown again."
msgstr "Скопіюйте цей токен зараз. Більше він не показуватиметься."

