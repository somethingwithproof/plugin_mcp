{
    "name": "cacti/plugin-mcp",
    "description": "Development dependencies for the Cacti MCP plugin",
    "type": "cacti-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=512M --no-progress",
        "test": "phpunit --configuration=phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
